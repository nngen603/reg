# Copy to .env and fill in only what you need.
# Nothing here is required to run offline, which is the default.

# ---- run mode -------------------------------------------------------------
# 1 = replay cassettes / use the deterministic stub. No API key, no cost.
# 0 = call a real provider (equivalent to the --live flag).
REGEXTRACT_OFFLINE=1
REGEXTRACT_RECORD=0                 # save live responses as cassettes for replay

# ---- models (LiteLLM model strings, reached through named routes) ---------
# The second model must be a DIFFERENT family from the primary -- that is what
# makes the agreement signal mean something. The primary has no fallback on
# purpose: if it cannot answer, the clause goes to review.
REGEXTRACT_PRIMARY_MODEL=anthropic/claude-opus-5
REGEXTRACT_SECOND_MODEL=openai/gpt-4.1
REGEXTRACT_SECOND_FALLBACKS=["groq/openai/gpt-oss-120b"]   # same-family entries are dropped
REGEXTRACT_AGREEMENT=1
REGEXTRACT_MAX_TOKENS=4000          # caps thinking AND output together; leave headroom
REGEXTRACT_CONCURRENCY=4
REGEXTRACT_NUM_RETRIES=2            # transport retries per call (LiteLLM Router)
REGEXTRACT_VALIDATION_RETRIES=1     # re-asks when a reply does not fit the contract (Instructor)
REGEXTRACT_INSTRUCTOR_MODE=tool_call   # or json_schema / json

# ---- provider keys (only for --live) --------------------------------------
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=                   # second-run fallback, judge, guardrail classifier

# ---- optional integrations ------------------------------------------------
REGEXTRACT_USE_QDRANT=0
QDRANT_URL=:memory:               # or http://localhost:6333
QDRANT_COLLECTION=regextract_clauses

REGEXTRACT_USE_GUARDRAILS=0         # policy classifier model; the regex scanner always runs
REGEXTRACT_GUARDRAIL_MODEL=groq/openai/gpt-oss-safeguard-20b
REGEXTRACT_USE_JUDGE=0              # LLM-as-judge, triage ordering only
REGEXTRACT_JUDGE_MODEL=groq/openai/gpt-oss-120b   # deliberately not the primary's family

REGEXTRACT_RESOLVE=1                # link external references to the corpus catalogue, or NOT_FOUND
# REGEXTRACT_RERANK_MODEL=jina_ai/jina-reranker-v2-base-multilingual   # needs JINA_API_KEY
# REGEXTRACT_EMBEDDING_MODEL=jina_ai/jina-embeddings-v2-base-en

# ---- human review ---------------------------------------------------------
REGEXTRACT_REVIEW=0                 # 1 = pause at human_review, resume with run.py review
# REGEXTRACT_CHECKPOINTS=outputs/checkpoints.sqlite

# ---- thresholds -----------------------------------------------------------
REGEXTRACT_FUZZY_THRESHOLD=92       # grounding gate: raise to be stricter
REGEXTRACT_THRESHOLD_HIGH=0.90      # PLACEHOLDERS -- not calibrated. See plan 7.3
REGEXTRACT_THRESHOLD_MEDIUM=0.80
REGEXTRACT_THRESHOLD_LOW=0.75
REGEXTRACT_MAX_UNGROUNDED=0.05      # document-level trigger
